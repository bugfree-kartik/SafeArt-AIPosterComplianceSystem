{
  "name": "safeart",
  "version": "0.1.0",
  "description": "SafeArt - AI Poster Compliance System",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "test:local": "npm run build && npm run test:local:job-creator",
    "test:local:job-creator": "cd packages/backend && node dist/test/job-creator-test.js",
    "test:local:worker": "cd packages/backend && node dist/test/worker-test.js",
    "test:e2e": "cd packages/backend && node dist/test/e2e-test.js",
    "test:dlq": "cd packages/backend && node dist/test/dlq-test.js",
    "test:integration": "cd packages/backend && node dist/test/integration-test.js",
    "test:crawler": "cd packages/crawler && node dist/test/crawler-test.js",
    "test:all": "npm run build && npm run test:e2e && npm run test:dlq && npm run test:integration",
    "crawler:demo": "cd packages/crawler && USE_DEMO=true node dist/index.js",
    "crawler:run": "cd packages/crawler && node dist/index.js",
    "local:setup": "bash scripts/setup-localstack.sh"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

